// User-level: ~/.config/opencode/opencode.jsonc
{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": {
    "treefmt": {
      // Configuration: ./.treefmt.toml
      "command": ["treefmt", "$FILE"],
      "extensions": [
        // Rust
        ".rs",
        // Nix
        ".nix"
      ]
    }
  },
  "references": {
    "docs": {
      "path": "docs"
    }
  },
  "permission": {
    "list": "allow",
    "lsp": "allow",
    "read": {
      "Justfile": "allow",
      ".example": "allow",
      // Project directories
      "docs/**/": "allow",
      "src/**/": "allow",
      "tests/**/": "allow",
      // Rust
      "*.rs": "allow",
      // Nix
      "*.nix": "allow",
      "*.envrc": "allow",
      // DB
      "*.sql": "allow",
      // Web
      "*.html": "allow",
      "*.js": "allow",
      "*.css": "allow",
      // Docs
      "*.org": "allow",
      // Config
      "*.jsonc": "allow",
      "*.json": "allow",
      "*.ron": "allow",
      "*.toml": "allow"
    },
    "glob": {
      // Docs
      "*.org": "allow",
      // Code
      "*.rs": "allow",
      // Config
      "*.nix": "allow",
      "*": "ask"
    },
    "write": {
      // Docs
      "*.org": "allow",
      // Code
      "*.rs": "allow",
      // Config
      "*.nix": "ask",
      "*.json": "ask",
      "*.toml": "ask",
      "*": "ask"
    },
    "bash": {
      // Unix
      "sudo *": "deny",
      "ls *": "allow",
      "mv *": "ask",
      "rm *": "deny",
      "mkdir *": "ask",
      // Find
      "fd *": "allow",
      "find *": "ask",
      // Match
      "head *": "allow",
      "tail *": "allow",
      "rg *": "allow",
      "grep *": "ask",
      "awk *": "ask",
      "gawk *": "ask",
      // Git
      "git status *": "allow",
      "git log *": "allow",
      "git ls *": "allow",
      "git diff *": "allow",
      "git checkout *": "allow",
      // Git - IO
      "git mv *": "ask",
      // Project
      "just *": "allow",
      "treefmt *": "allow",
      // Nix
      "nixfmt *": "ask",
      // Rust
      "cargo doc *": "allow",
      "cargo spellcheck *": "allow",
      "cargo fmt *": "allow",
      "cargo check *": "allow",
      "cargo clippy *": "allow",
      "cargo nextest *": "allow",
      "cargo test *": "allow",
      "cargo build *": "allow",
      "cargo run *": "ask",
      // Rust - Crates
      "cargo add *": "ask",
      "cargo remove *": "ask",
      // Diesel
      "diesel print-schema *": "allow",
      // Python
      "python *": "deny",
      "python3 *": "deny",
      "*": "ask"
    },
    "webfetch": "ask"
  }
}
